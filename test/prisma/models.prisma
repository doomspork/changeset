// The test database. Columns are mapped to snake_case on purpose, so tests see whether errors report
// field names or column names.

enum ProjectStatus {
  draft
  active
  archived
}

model Account {
  id       String    @id @default(uuid())
  name     String
  users    User[]
  projects Project[]

  @@map("accounts")
}

model User {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  account   Account   @relation(fields: [accountId], references: [id])
  email     String    @unique
  projects  Project[]

  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  accountId   String        @map("account_id")
  account     Account       @relation(fields: [accountId], references: [id])
  name        String
  slug        String
  description String?
  status      ProjectStatus @default(draft)
  priority    Int           @default(0)
  settings    Json          @default("{}")
  ownerId     String        @map("owner_id")
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([accountId, slug])
  @@map("projects")
}

// An audit log keeps the project's id as a plain column, not a foreign key, so entries outlive the project.
model AuditEntry {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  actorId   String   @map("actor_id")
  action    String
  diff      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_entries")
}

// The adapter contract's table: a unique column, a self-referencing foreign key that restricts deletes,
// and a check constraint added in SQL.
model Item {
  id        String   @id @default(uuid())
  sku       String   @unique
  name      String
  qty       Int      @default(0)
  parentId  String?  @map("parent_id")
  parent    Item?    @relation("ItemParent", fields: [parentId], references: [id], onDelete: Restrict)
  children  Item[]   @relation("ItemParent")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("items")
}
